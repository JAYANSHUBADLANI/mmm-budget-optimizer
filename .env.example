# Copy this file to .env and fill in your own values. .env is gitignored.

# FRED API key, free from https://fred.stlouisfed.org/docs/api/api_key.html
# Used by src/mmm/enrichment.py to pull the CPI series.
FRED_API_KEY=

# Kaggle API credentials, from https://www.kaggle.com/settings -> Create New Token
# Either set these two variables or place kaggle.json in ~/.kaggle/
KAGGLE_USERNAME=
KAGGLE_KEY=

# Series and geography settings for enrichment
FRED_SERIES_ID=CPIAUCSL
TRENDS_KEYWORD=online shopping
TRENDS_GEO=US
HOLIDAY_COUNTRY=US
